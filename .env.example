# Environment variable template for AI-IDS.
#
# All values below are non-secret configuration for local development.
# Copy this file to .env (not committed) if you want to override defaults;
# the backend runs with sensible defaults even without a .env file.
#
# Do not put real secrets, keys, or credentials in this file or in .env.

# Display name used in logs/startup messages.
APP_NAME=AI-IDS API

# development | production (affects default debug/logging behavior)
ENVIRONMENT=development

# Prefix under which all v1 API routes are mounted.
API_V1_PREFIX=/api/v1

# Enables debug-level logging.
DEBUG=true

# Comma-separated list of frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
