# Environment variable template for AI-IDS.
#
# All values below are non-secret configuration for local development.
# Copy this file to .env (not committed) if you want to override defaults;
# the backend runs with sensible defaults even without a .env file.
#
# Do not put real secrets, keys, or credentials in this file or in .env.

# Display name used in logs/startup messages.
APP_NAME=AI-IDS API

# development | production (affects default debug/logging behavior)
ENVIRONMENT=development

# Prefix under which all v1 API routes are mounted.
API_V1_PREFIX=/api/v1

# Enables debug-level logging.
DEBUG=true

# Comma-separated list of frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# SQLAlchemy database URL. Defaults to a local SQLite file under backend/data/.
# The database file itself is not committed (see .gitignore).
DATABASE_URL=sqlite:///./data/ai_ids.db

# Where uploaded CSVs are stored (relative to the backend working directory).
# Contents are untrusted user data and are never committed (see .gitignore).
UPLOAD_DIR=./data/uploads

# Maximum accepted CSV upload size, in megabytes.
MAX_UPLOAD_MB=50

# Default idle timeout (seconds) before a packet-derived flow is
# finalized, for both PCAP file uploads (Step 41) and live capture
# sessions (Step 42). See backend/README.md's "PCAP Ingestion" section.
PCAP_FLOW_IDLE_TIMEOUT_SECONDS=120

# Threat intelligence (Step 40) — disabled by default. See backend/README.md's
# "Threat Intelligence" section for what each of these does and what remains
# unconfigured/unverified by default.
THREAT_INTEL_ENABLED=false
THREAT_INTEL_PROVIDER=abuseipdb
# A real API key is a SECRET: never put a real value here or in a committed
# .env file. Set it only in your local, uncommitted .env or your shell
# environment.
THREAT_INTEL_API_KEY=
THREAT_INTEL_TIMEOUT_SECONDS=5
THREAT_INTEL_MAX_RETRIES=1
THREAT_INTEL_CACHE_TTL_SECONDS=3600
