# Frontend environment template for AI-IDS.
#
# Copy to frontend/.env (never committed) to override defaults.
#
# IMPORTANT: every VITE_* variable is embedded into the JavaScript bundle and
# is readable by anyone using the app in a browser. Never put API secrets,
# passwords, private tokens, or database credentials here.

# Base URL of the FastAPI backend (no trailing slash needed).
VITE_API_BASE_URL=http://localhost:8000
